// Desktop pipeline: BC7 textures, highest quality (meshopt_compression opt-in).
.{
    .name = "desktop",
    .target = .desktop,
    .steps = .{
        .{ .prune = .{
            .unused_nodes = true,
            .unused_materials = true,
            .unused_textures = true,
        } },
        .{ .dedup = .{
            .accessors = true,
            .meshes = true,
            .materials = true,
        } },
        .{ .weld = .{ .tolerance = 0.0 } },
        .{ .join = .{} },
        .{
            .textures = .{
                .format = .bc7,
                .quality = 255,
                // 0.5 RDO: byte-identical to 1.0 at q255 (BoomBox bench), less compute.
                .rdo_lambda = 0.5,
                .normal_maps_renormalize = true,
                .generate_mips = true,
                .max_size = 0,
                // UASTC payload zstd (scheme 2): smaller disk bytes, VRAM unchanged.
                .supercompression = .zstd,
            },
        },
        .{ .quantize = .{
            .position_bits = 14,
            .normal_oct = true,
            .uv_bits = 12,
            .meshopt_compression = true,
        } },
    },
}
