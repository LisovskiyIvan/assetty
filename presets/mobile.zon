// Mobile pipeline: ASTC textures, meshopt compression, no simplification.
.{
    .name = "mobile",
    .target = .mobile,
    .steps = .{
        .{ .prune = .{
            .unused_nodes = true,
            .unused_materials = true,
            .unused_textures = true,
        } },
        .{ .dedup = .{
            .accessors = true,
            .meshes = true,
            .materials = true,
        } },
        .{ .weld = .{ .tolerance = 0.0 } },
        .{ .join = .{} },
        .{ .textures = .{
            .format = .astc,
            .quality = 160,
            .rdo_lambda = 1.0,
            .normal_maps_renormalize = true,
            .generate_mips = true,
            .max_size = 2048,
        } },
        .{ .quantize = .{
            .position_bits = 14,
            .normal_oct = true,
            .uv_bits = 12,
            .compress = true,
        } },
        // Optional aggressive step for mobile - not enabled by default:
        // .{ .simplify = .{ .target_ratio = 0.5, .aggressive = true } },
    },
}
